# dp_exchange_core — environment variable template.
#
# This is the ONLY .env file that is committed. `.gitignore` carries
# `.env*` / `!.env.sample`; every other .env is yours and stays local (§7.7).
#
# Copy to `.env` and fill in real values:
#
#     cp .env.sample .env
#
# Secrets live in .env files and nowhere else. There is no `config/*.secret.exs`
# and no Vault layer in this repo.

# ---------------------------------------------------------------------------
# Publishing
# ---------------------------------------------------------------------------

# Hex API key with publish rights on the DistortionPoint organisation.
# Needed only to publish by hand; CI publishes with the org key held as a
# repository secret (D4). Values: an org-scoped key from `mix hex.user key generate`.
HEX_API_KEY=<your-hex-api-key>

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# None. `dp_exchange_core` is a contract library — it opens no sockets and
# holds no credentials, so `config/runtime.exs` reads nothing today. Venue
# packages are where credentials appear, and they arrive as function arguments
# rather than being read from the environment (invariant #2).
