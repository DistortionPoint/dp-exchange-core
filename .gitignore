# Build and deps
/_build/
/deps/
*.ez
*.beam

# Test and coverage
/cover/

# Documentation
/doc/

# Hex package artifacts
dp_exchange_core-*.tar

# Dialyzer PLTs
priv/plts/

# Crash dumps
erl_crash.dump

# Temporary files
/tmp/
*.swp
*.swo
*~

# Mix fetch marker
/.fetch

# IDE / editor
.elixir_ls/
.vscode/
.idea/
*.code-workspace

# OS
.DS_Store
Thumbs.db

# Environment / secrets — .env.sample is the ONLY committed one (§7.7, D17)
.env*
!.env.sample

# MCP config — carries a bearer token; each developer writes their own (Phase 0.12, D17)
.mcp.json

# Claude Code local state — agents ARE shared and committed; these are not
.claude/settings.local.json
.claude/projects/

# Playwright MCP scratch — page snapshots and console logs from browser-driven
# documentation reads. Never a package artifact.
.playwright-mcp/

# Saved-page asset bundles from the Schwab developer portal capture.
#
# The `_files/` directories are Schwab's own compiled JS and CSS — 7.5 MB, duplicated
# across two page saves, and of no informational value: the content was extracted into
# `dp_exchange_schwab/docs/reference/schwab/` (both specs, both prose documents, the 17
# User Guides). **This repo is public and history is not retractable**, so republishing a
# third party's compiled front-end assets permanently is not something to do by accident.
# The HTML pages themselves are kept.
docs/reference/schwab-portal-capture/**/*_files/
